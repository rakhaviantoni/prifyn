# Local development values. In Netlify, replace the application and auth
# origins with the deployed HTTPS origin. Do not include a path or trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
PRIFYN_APP_HOSTNAME=app.prifyn.rakhaviantoni.com
PRIFYN_CREATOR_HOSTNAME=creator.prifyn.rakhaviantoni.com
NEXT_PUBLIC_PRIFYN_APP_HOSTNAME=app.prifyn.rakhaviantoni.com
NEXT_PUBLIC_PRIFYN_CREATOR_HOSTNAME=creator.prifyn.rakhaviantoni.com

# PostgreSQL / Supabase pooled connection string
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:6543/postgres?sslmode=require
# Optional direct or session-pooler URL used only by Drizzle migrations.
DATABASE_MIGRATION_URL=

# Supabase Storage for brand logos and future uploads.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=prifyn-assets
# Public Book / Apply forms save to this workspace brand.
# Set these to the PRIFYN workspace/brand IDs in production.
PRIFYN_INTAKE_WORKSPACE_ID=
PRIFYN_INTAKE_ORGANIZATION_ID=
# PRIFYN-side Business Manager access. Comma-separated admin emails.
PRIFYN_ADMIN_EMAILS=privynindonesia@gmail.com

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# In Netlify production, include every origin that can start sign-in:
# BETTER_AUTH_TRUSTED_ORIGINS=https://prifyn.rakhaviantoni.com,https://app.prifyn.rakhaviantoni.com,https://creator.prifyn.rakhaviantoni.com
# Optional comma-separated hosts when one deploy serves both marketing and app domains.
# Example: app.prifyn.rakhaviantoni.com,creator.prifyn.rakhaviantoni.com,prifyn.rakhaviantoni.com
BETTER_AUTH_ALLOWED_HOSTS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Background runners. Configure Netlify scheduled calls with Authorization: Bearer <secret>.
REPORT_SCHEDULE_SECRET=
WEBHOOK_DELIVERY_SECRET=

# AI Business Copilot: DeepSeek is OpenAI-compatible. Leave key empty for safe offline mode.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional legacy OpenAI-compatible provider values. Ask PRIFYN defaults to DeepSeek now.
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
SUMOPOD_API_KEY=
SUMOPOD_MODEL=

# Paid channel provider apps. Connections remain unavailable until each
# provider approves the app and all credentials for that provider are present.
INTEGRATION_TOKEN_ENCRYPTION_KEY=
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_GRAPH_API_VERSION=v23.0
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
GOOGLE_ADS_API_VERSION=v25
TIKTOK_BUSINESS_APP_ID=
TIKTOK_BUSINESS_APP_SECRET=
TOKOPEDIA_PARTNER_ID=
TOKOPEDIA_PARTNER_SECRET=
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
